# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=example.ir,www.example.ir
CSRF_TRUSTED_ORIGINS=https://example.ir,https://www.example.ir
SITE_URL=https://example.ir
# Set to 0 only while testing without HTTPS.
USE_HTTPS=1

POSTGRES_DB=fairtrade
POSTGRES_USER=fairtrade
POSTGRES_PASSWORD=change-me

EMAIL_HOST=smtp.example.ir
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@example.ir

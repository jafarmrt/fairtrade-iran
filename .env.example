# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=example.ir,www.example.ir
CSRF_TRUSTED_ORIGINS=https://example.ir,https://www.example.ir
SITE_URL=https://example.ir
# Set to 0 only while testing without HTTPS.
USE_HTTPS=1

POSTGRES_DB=fairtrade
POSTGRES_USER=fairtrade
POSTGRES_PASSWORD=change-me

EMAIL_HOST=smtp.example.ir
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@example.ir

# SMS provider and texts are set in the admin panel. Optionally keep the
# provider's API key here instead of in the database:
SMS_API_KEY=

# Ports nginx listens on (normally leave as is).
HTTP_PORT=80
HTTPS_PORT=443
# After deploy/init-https.sh has fetched the certificate, uncomment:
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml

# Optional PyPI mirror if the server cannot reach pypi.org.
# PIP_INDEX_URL=https://pypi.org/simple

# Daily backup into ./backups (time is in BACKUP_TZ).
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
BACKUP_TZ=Asia/Tehran

# Daily site jobs (membership deadline reminders to secretariat/commission).
DAILY_JOBS_TIME=08:00
DAILY_JOBS_TZ=Asia/Tehran

# Test copy of the site with demo data, for a free host such as Render
# (render.yaml, guide: docs/demo-fa.md). Not for the real site.
#
# The database (SQLite) and pictures are built into the image, so every start
# begins from the same clean demo content: anything changed while testing is
# lost when the service restarts or goes to sleep.

FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000 \
    DJANGO_SETTINGS_MODULE=fairtrade.settings.production \
    DEMO_MODE=1 \
    DATABASE_URL=sqlite:////app/demo/demo.sqlite3 \
    PAYMENT_ALLOW_TEST_GATEWAY=1 \
    EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend \
    SMS_BACKEND=sms.backends.ConsoleBackend \
    WEB_CONCURRENCY=2

RUN useradd --create-home wagtail
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=wagtail:wagtail . .
RUN mkdir -p /app/media /app/private_media /app/staticfiles /app/demo \
    && chown -R wagtail:wagtail /app
USER wagtail

# Build-time only values: the real SECRET_KEY and DEMO_PASSWORD come from the host at runtime.
RUN export SECRET_KEY=build-only ALLOWED_HOSTS=localhost \
    && python manage.py collectstatic --noinput \
    && python manage.py migrate --noinput \
    && DEMO_PASSWORD=build-only-placeholder python manage.py seed_demo

EXPOSE 8000
CMD ["sh", "-c", "python manage.py seed_demo --passwords-only && gunicorn fairtrade.wsgi:application --bind 0.0.0.0:${PORT} --workers ${WEB_CONCURRENCY} --timeout 60"]
